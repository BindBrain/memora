# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Environment secrets: keep real local values private
.env*
!.env.example

# Local editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local backups; do not publish recovery copies
*.bak
*.backup
*.before-*
*.bak.*
*.backup.*

# Local logs and temporary output
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
