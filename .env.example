# Memora server port (change if this port is already in use)
PORT=3000

# Copy this file to .env and fill in your local values.
# Never commit .env or put real credentials in this template.

# PostgreSQL connection for Prisma
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/memora?schema=public"

# Generate a base64-encoded 32-byte encryption key for local development.
# Example PowerShell command:
# [Convert]::ToBase64String([Security.Cryptography.RandomNumberGenerator]::GetBytes(32))
APP_ENCRYPTION_KEY="REPLACE_WITH_YOUR_OWN_KEY"

# Optional: alternatively configure provider keys in Memora Settings.
# Do not put real API keys in this template.
GROQ_API_KEY=""

# Docker Compose reads POSTGRES_PASSWORD from .env.docker, not this template.
POSTGRES_PASSWORD="REPLACE_WITH_A_LOCAL_DATABASE_PASSWORD"
